# Environment variables for Lab-automation.
# Copy to `.env` (git-ignored) and fill in. Spring Boot does not read .env by itself:
# set these in your IDE Run Configuration (Environment variables) or export them in your shell.
# NEVER commit real values.

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=dev

# --- AWS S3 (lab logo, certificates, report signatures) ---
# Bucket and region are required. application-dev.yml defaults the region to ap-south-1;
# the base application.yml and prod have NO default, so set both in ECS / prod.
AWS_S3_BUCKET=tiameds-lab-test-2
AWS_REGION=ap-south-1


# Credentials - local development only. Either pair works:
AWS_ACCESS_KEY=your-aws-access-key-id
AWS_SECRET_KEY=your-aws-secret-access-key




# --- Onboarding / password reset links (frontend URLs) ---
ONBOARDING_FRONTEND_BASE_URL=http://localhost:3000
ONBOARDING_ONBOARDING_URL=http://localhost:3000/onboarding
ONBOARDING_VERIFICATION_URL=http://localhost:3000/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password
