              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "labLogo",
                  "type": "file",
                  "src": [],
                  "description": "run when the lab has no logo stored via this API"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/lab/admin/{{labId}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
