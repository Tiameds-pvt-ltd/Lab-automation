        {
          "name": "Delete - one valid + one that does not exist (expect 400, nothing deleted)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/lab/admin/{{labId}}/documents?types=labLogo&types=nablAccreditationCertificate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "lab",
                "admin",
                "{{labId}}",
                "documents"
              ],
              "query": [
                {
                  "key": "types",
                  "value": "labLogo"
                },
                {
                  "key": "types",
