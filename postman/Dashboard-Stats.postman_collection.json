{
  "info": {
    "name": "Lab Super Admin Dashboard",
    "description": "Login + all super-admin dashboard/KPI endpoints (SuperAdminStatsController, SuperAdminDashboardController, DashboardRollupAdminController). Run \"Login\" first — it auto-captures the JWT into {{token}}, which every dashboard request below sends as `Authorization: Bearer {{token}}`.\n\nBase URL: {{baseUrl}} (context path /api/v1 included in each request path below).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "username", "value": "", "type": "string" },
    { "key": "password", "value": "", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "labId", "value": "", "type": "string" },
    { "key": "startDate", "value": "2026-04-01", "type": "string" },
    { "key": "endDate", "value": "2026-09-03", "type": "string" },
    { "key": "limit", "value": "10", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Login",
      "item": [
        {
          "name": "Login (get token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body && body.token) {",
                  "    pm.collectionVariables.set('token', body.token);",
                  "    console.log('token captured:', body.token);",
                  "} else {",
                  "    console.warn('No token in login response body:', body);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "login"]
            },
            "description": "POST /public/login — returns { status, message, token, data }. The test script above stores `token` into the collection variable {{token}} automatically."
          },
          "response": []
        }
      ]
    },
