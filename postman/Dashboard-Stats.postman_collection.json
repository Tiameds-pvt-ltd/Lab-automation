                { "key": "labId", "value": "{{labId}}", "disabled": true }
              ]
            },
            "description": "One-time/on-demand backfill for the daily_lab_stats rollup table (DashboardRollupAdminController). Omit labId to backfill every lab. Safe to re-run for any date range at any time."
          },
